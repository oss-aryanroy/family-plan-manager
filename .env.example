# Required in production: your sign-in. Quote the password if it has # or $ in it: OWNER_PASSWORD='...'
OWNER_USERNAME=
OWNER_PASSWORD=

# Signs login sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Your time zone, so "today" and overdue days match your calendar.
OWNER_TZ=America/New_York

# Storage. On Vercel, add Upstash Redis from the Marketplace and these are set for you.
# Without them, local dev stores data in .data/db.json (or the file named by DATA_FILE).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: your GitHub repository, linked from the About section on the sign-in page.
NEXT_PUBLIC_REPO_URL=https://github.com/oss-aryanroy/family-plan-manager
